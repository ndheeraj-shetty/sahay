# Application
APP_ENV=development
APP_NAME=SAHAY
APP_VERSION=1.0.0
DEBUG=True
API_V1_STR=/api/v1

# Security
SECRET_KEY=sahay-development-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default Docker PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sahay_db
# Sync connection for Alembic migrations if needed
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sahay_db

# Redis & Celery (Future phases)
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MinIO / S3 Object Storage (Future phases)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=sahay-vault
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI Integrations (Configured when needed)
GEMINI_API_KEY=
OPENAI_API_KEY=
