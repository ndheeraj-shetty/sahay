# SAHAY Production Environment Variables
APP_ENV=production
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-64-character-string

# PostgreSQL Database Settings
POSTGRES_USER=sahay_admin
POSTGRES_PASSWORD=SecurePassword123!
POSTGRES_DB=sahay_db

# Google Gemini API Key for Sahay AI Assistant & Document Doctor
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.1-flash-lite

# Redis Cache URL
REDIS_URL=redis://redis:6379/0
